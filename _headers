# Tarumak Studio — Cloudflare Pages _headers

# Security headers for every response.
# - HSTS: browsers always use HTTPS (no includeSubDomains/preload, so
#   other subdomains are unaffected).
# - X-Frame-Options / frame-ancestors: the site can't be framed (clickjacking).
# - Permissions-Policy: camera (Scan to PDF, OCR) and microphone (French
#   Academy speaking practice) are for this site only; location, payment
#   and USB are off.
# - "! Access-Control-Allow-Origin" removes Cloudflare's default "*" so
#   other sites can't read our pages with fetch(). Nothing here needs it.
# - Content-Security-Policy is ENFORCED: scripts, fonts, connections and
#   frames may only use the hosts listed. When a tool or page needs a new
#   host, add it here and test on a preview deploy first. To go back to
#   logging only, rename it to Content-Security-Policy-Report-Only.
#   'unsafe-eval' is required by the Background Remover's AI runtime;
#   'unsafe-inline' by the inline scripts and handlers in the pages.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; connect-src 'self' data: blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://staticimgly.com https://tessdata.projectnaptha.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://api.web3forms.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Disable caching for HTML pages so deploys take effect immediately

/article-*
  Cache-Control: no-cache, must-revalidate

/blog.html
  Cache-Control: no-cache, must-revalidate

/blog
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

# Disable caching for all site JS. Every tool, config.js, and the GA4
# loader-injection logic live in these files — without this, Cloudflare's
# default static-asset caching (long max-age) can keep serving a
# pre-deploy version of a .js file indefinitely after every push, so a
# shipped fix silently doesn't reach real visitors even though the
# source and the live HTML are correct. HTML already forces a
# revalidate above; without the same rule here, an old *.js can still
# be paired with new *.html and reintroduce fixed bugs.
/*.js
  Cache-Control: no-cache, must-revalidate
